{
    "name": "mangoweb-sylius/sylius-extended-channels",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Extended channels plugin for Sylius",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "sylius/sylius": "^2.1"
    },
    "require-dev": {
        "behat/behat": "^3.34 || ^4.0",
        "behat/mink": "^1.11",
        "behat/mink-selenium2-driver": "^v1.7.0",
        "dbrekelmans/bdi": "^1.4",
        "dmore/chrome-mink-driver": "^2.9.3",
        "friends-of-behat/mink-browserkit-driver": "^v1.6.2",
        "friends-of-behat/mink-debug-extension": "^v2.1.0",
        "friends-of-behat/mink-extension": "^2.7.5 || ^3.0@alpha",
        "friends-of-behat/page-object-extension": "^v0.3.2",
        "friends-of-behat/suite-settings-extension": "^v1.1.0",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^v1.6.0",
        "nyholm/psr7": "^1.8",
        "php-http/message-factory": "^1.1.0",
        "phpstan/phpstan": "^2.1.10",
        "phpstan/phpstan-doctrine": "^2.0.12",
        "phpstan/phpstan-strict-rules": "^2.0.4",
        "phpstan/phpstan-symfony": "^2.0.3",
        "phpstan/phpstan-webmozart-assert": "^2.0.0",
        "phpunit/phpunit": "^11.1 || ^12.0.10",
        "robertfausk/behat-panther-extension": "^1.2 || ^2.0",
        "rector/rector": "^2.0.10",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^v4.4.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/doctrine-bridge": "^7.4 || ^8.0",
        "symfony/doctrine-messenger": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/maker-bundle": "^1.60",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/var-exporter": "^7.4 || ^8.0",
        "symfony/var-dumper": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symplify/easy-coding-standard": "^12.0",
        "sylius/sylius-rector": "^v3.0.0"
    },
    "conflict": {
        "api-platform/symfony": "<4.2.0",
        "api-platform/core": "<4.2.0",
        "api-platform/json-schema": "<4.2.0",
        "api-platform/metadata": "<4.2.0",
        "babdev/pagerfanta-bundle": "<3.6.1",
        "doctrine/collections": "<1.7.0",
        "doctrine/data-fixtures": "<1.8.0",
        "doctrine/dbal": "<2.13.3",
        "doctrine/doctrine-bundle": "<2.8.0",
        "friendsofsymfony/rest-bundle": "<3.1.0",
        "jms/serializer-bundle": "<4.2.0",
        "knplabs/knp-menu": "<3.3.0",
        "knplabs/knp-menu-bundle": "<3.5.0",
        "lexik/jwt-authentication-bundle": "<2.12",
        "liip/imagine-bundle": "2.17.0",
        "masterminds/html5": "<2.7.5",
        "payum/core": "<1.7.3",
        "sylius/sylius": "<2.1.0",
        "sylius/grid-bundle": "1.16.0",
        "sylius/resource-bundle": "<1.13.1",
        "sylius/twig-hooks": ">=0.9.0 <0.9.1",
        "sylius/twig-extra": ">=0.9.0 <0.9.1",
        "symfony/css-selector": "<4.4.24",
        "symfony/dom-crawler": "8.1.0",
        "symfony/framework-bundle": ">=5.4.0 <=5.4.20|>=6.0.0 <=6.0.16|>=6.1.0 <=6.1.8|>=6.2.0 <=6.2.2|6.2.8",
        "symfony/mime": "<5.4.0",
        "symfony/panther": "<2.2.0",
        "symfony/web-link": "<5.3.0",
        "symplify/easy-coding-standard": "<10.2.0",
        "twig/twig": "<2.14.7",
        "webmozart/assert": "<1.11.0",
        "willdurand/negotiation": "<3.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MangoSylius\\ExtendedChannelsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\MangoSylius\\ExtendedChannelsPlugin\\": "tests/Application/src/",
            "Tests\\MangoSylius\\ExtendedChannelsPlugin\\Behat\\": "tests/Behat/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "COMPOSER_AUDIT_ABANDONED=ignore composer audit": "script"
        }
    }
}
